// Mission 01: the KQL I ran in Sentinel → Logs

// Is my machine showing up at all yet?
Heartbeat
| take 10

// When did my machine last check in?
Heartbeat
| summarize LastSeen = max(TimeGenerated) by Computer

// When did my machine send its very first heartbeat?
Heartbeat
| where Computer startswith "WKS-L58"
| summarize FirstHeartbeat = min(TimeGenerated)

// Is the data current, or is the machine's clock off? (event time vs. when it reached the workspace)
Heartbeat
| project TimeGenerated, ingestion_time(), Delay = ingestion_time() - TimeGenerated
| take 20

// What severity levels are coming into the Event table?
Event
| summarize count() by EventLevelName

// Who logged on to my machine, and when? (Event table, where the details are one big text field)
Event
| where EventLog == "Security" and EventID == 4624
| project TimeGenerated, Computer, RenderedDescription
| order by TimeGenerated desc

// Who logged on, and how? (SecurityEvent, where account, logon type and IP are proper columns)
SecurityEvent
| where EventID == 4624
| project TimeGenerated, Computer, Account, LogonType, IpAddress
| order by TimeGenerated desc

// When was my own first RDP logon? (logon type 10 = new session, 7 = reconnecting to an open one)
SecurityEvent
| where EventID == 4624 and LogonType in (10, 7)
| project TimeGenerated, LogonType, IpAddress
| order by TimeGenerated asc
| take 1

// Did the Event table really stop getting Security logs after I removed them from dcr-windowsevents?
Event
| where EventLog == "Security"
| summarize LastSecurityRow = max(TimeGenerated)

// Step 6: what happened on my machine during the window when it wasn't me? (the intrusion was on 9 Oct 2026 at 12:30:07 UTC)
SecurityEvent
| where TimeGenerated between (datetime(2026-10-09 12:25) .. datetime(2026-10-09 12:35))
| summarize count() by EventID, Activity
| order by count_ desc

// Step 6: every account-management event in the last 30 days (this is how I found svc_backup without knowing the Event ID first)
SecurityEvent
| where TimeGenerated > ago(30d)
| where EventID in (4720, 4722, 4724, 4725, 4726, 4728, 4732, 4738, 4781)
| project TimeGenerated, EventID, Activity, SubjectAccount, TargetAccount, MemberSid, Computer
| order by TimeGenerated asc

// Step 6: was I connected when it happened? (my RDP logons that day)
SecurityEvent
| where TimeGenerated between (datetime(2026-10-09) .. datetime(2026-10-10))
| where EventID == 4624 and LogonType in (10, 7)
| project TimeGenerated, LogonType, IpAddress, TargetAccount

// What just happened?: is the qemu-ga trace in my SIEM? (0 results: only Critical/Error/Warning from Application are collected)
Event
| where Source == "qemu-ga" or RenderedDescription has "qemu-ga"
| sort by TimeGenerated desc
| take 10
