// Mission 01 — queries I used in Sentinel → Logs (KQL mode)
// DRAFT: delete any query I didn't actually run, and add the ones I did.

// Is my machine sending heartbeats at all? (first check after creating the DCR)
Heartbeat
| take 10

// Is my machine talking to me, and when did it last check in?
Heartbeat
| summarize LastSeen = max(TimeGenerated) by Computer

// Is the data current, or is the source's clock wrong? (event time vs ingestion time)
Heartbeat
| project TimeGenerated, ingestion_time(), Delay = ingestion_time() - TimeGenerated
| take 20

// What kinds of events is chain A (Event table) collecting, by level?
Event
| summarize count() by EventLevelName

// Who logged in, and when? (chain A — Security log in the Event table, as text)
Event
| where EventLog == "Security" and EventID == 4624
| project TimeGenerated, Computer, RenderedDescription
| order by TimeGenerated desc

// Which of those chain A logons are mine and not the computer's own? (TODO: put my account name in)
Event
| where EventLog == "Security" and EventID == 4624
| where RenderedDescription has "TODO-my-account"
| project TimeGenerated, Computer, RenderedDescription
| order by TimeGenerated desc

// Who logged in, and when? (chain B, SecurityEvent table, already split into columns)
SecurityEvent
| where EventID == 4624
| project TimeGenerated, Computer, Account, LogonType, IpAddress
| order by TimeGenerated desc

// Did chain A really stop collecting Security events after I removed them from dcr-windowsevents?
Event
| where EventLog == "Security"
| summarize LastSecurityEventInEventTable = max(TimeGenerated)

// What happened on my machine in the Step 6 window that wasn't me? (TODO: set the time window)
SecurityEvent
| where TimeGenerated between (datetime(TODO-start) .. datetime(TODO-end))
| summarize count() by EventID, Activity
| order by count_ desc

